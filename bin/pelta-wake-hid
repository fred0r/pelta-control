#!/usr/bin/env python3
import json, os, select, subprocess, time

# Connections in order of preference. The cable wins when both are present,
# since the headset is then talking to the computer directly.
DEVICES = [("/dev/pelta-hid-usb", "USB"), ("/dev/pelta-hid-dongle", "2.4GHz")]
RECHECK = 3        # seconds between checks for a connection change
RECOVER_GAP = 5    # one wake can be seen twice (push + poll); fix the volume once
RECOVER = os.path.expanduser("~/.local/bin/pelta-recover")
STATE_FILE = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "pelta.json")
CACHE_FILE = os.path.expanduser("~/.cache/pelta-battery")
LOW_DEFAULT = 15  # used until the headset reports its own alert level

# Status queries Armoury Crate sends. Replies arrive as normal reports:
#   cc 12 00 00 01 -> byte 5: 1 = headset connected
#   cc 12 08       -> byte 5: 1 = charging
#   cc 12 07       -> byte 5: sleep timer, byte 6: battery %, byte 7: alert % (0 = off),
#                     byte 8: spoken low-battery warning on/off
# A sleeping headset answers everything with "ff aa".
QUERIES = [bytes.fromhex(h) for h in ("cc12000001", "cc1208", "cc1207")]
# Asked every few seconds on the dongle: switching the headset off and on (or
# through USB mode) sends no report, but the dongle answers this with 00 while
# the headset is off and 01 once it's back.
POLL = bytes.fromhex("cc12000001") + bytes(59)
last_recover = 0.0

state = {"battery": None, "live": False, "charging": None, "awake": None,
         "alert": LOW_DEFAULT, "mode": None}
try:
    state["battery"] = int(open(CACHE_FILE).read())
except (OSError, ValueError):
    pass


def notify(title, body):
    subprocess.run(["notify-send", "-a", "ROG Pelta", title, body])


def save():
    tmp = STATE_FILE + ".tmp"
    with open(tmp, "w") as f:
        json.dump(state, f)
    os.replace(tmp, STATE_FILE)
    if state["battery"] is not None:
        os.makedirs(os.path.dirname(CACHE_FILE), exist_ok=True)
        with open(CACHE_FILE, "w") as f:
            f.write(str(state["battery"]))


def query(fd):
    for q in QUERIES:
        os.write(fd, q + bytes(64 - len(q)))
        time.sleep(0.2)


def set_battery(value):
    if value > 100:
        print("Ignoring battery value", value, flush=True)
        return
    old = state["battery"] if state["live"] else None
    state["battery"], state["live"] = value, True
    save()
    print(f"Battery {value}%", flush=True)
    low = state["alert"]                   # None = alert turned off on headset
    if low is not None and not state["charging"] and value <= low and (old is None or old > low):
        notify("Headset battery low", f"{value}% remaining")
    if state["charging"] and value >= 100 and (old or 0) < 100:
        notify("Headset fully charged", "100%")


def headset_back(fd, why):
    """The headset just woke or reconnected: it's at max volume, so fix it."""
    global last_recover
    was = state["awake"]
    state["awake"] = True
    save()
    if was is True or time.time() - last_recover < RECOVER_GAP:
        return
    print(why, flush=True)
    last_recover = time.time()
    subprocess.run([RECOVER])
    query(fd)                              # refresh battery and charging too


def handle(r, fd):
    if len(r) < 8 or r[0] != 0xCC or r[1] != 0x12:
        return
    kind, value = r[2], r[5]

    if kind == 0x0E:                       # wake / sleep (pushed by headset)
        if r[3:8] == bytes(5):
            state["awake"] = False         # force the fix even if a poll got here first
            headset_back(fd, "Wake detected")
        else:
            state["awake"] = False
            save()
        return

    if r[5:7] == b"\xff\xaa":              # headset asleep / unreachable
        return

    if kind == 0x00:                       # connection status reply
        # Dongle: byte 5 is 1/0 for "headset connected". Wired USB: byte 5
        # is 0 followed by other data, and the headset is always reachable,
        # so only an all-zero reply means asleep.
        if value == 1:
            headset_back(fd, "Headset connected")
        elif not any(r[6:16]):
            state["awake"] = False
            save()

    elif kind == 0x09:                     # battery % (pushed)
        set_battery(value)

    elif kind == 0x07:                     # settings reply, battery in byte 6
        state["awake"] = True               # it answered, so it's awake
        state["alert"] = r[7] or None       # 0 = alert off; r[8] is the voice warning
        set_battery(r[6])

    elif kind == 0x08:                     # charging (pushed or reply)
        state["charging"] = value == 1
        save()
        print(f"Charging: {state['charging']}", flush=True)


def find_device():
    for path, mode in DEVICES:
        if os.path.exists(path):
            return path, mode
    return None, None


save()
while True:
    dev, mode = find_device()
    if dev is None:
        if state["mode"] is not None:
            state["mode"], state["awake"], state["live"] = None, None, False
            state["charging"] = None
            save()
            print("Headset disconnected, waiting", flush=True)
        time.sleep(RECHECK)
        continue
    try:
        fd = os.open(dev, os.O_RDWR)
    except OSError:
        time.sleep(RECHECK)
        continue
    state["mode"], state["awake"] = mode, None
    state["charging"] = None
    save()
    print(f"Listening on {dev} ({mode})", flush=True)
    try:
        query(fd)                          # get real values for this connection
        next_check = time.time() + RECHECK
        while True:
            if select.select([fd], [], [], max(0, next_check - time.time()))[0]:
                r = os.read(fd, 256)
                if not r:
                    break
                handle(r, fd)
            if time.time() < next_check:
                continue
            next_check = time.time() + RECHECK
            if find_device()[0] != dev:    # the other connection appeared
                print("Connection changed", flush=True)
                break
            if mode == "2.4GHz":
                os.write(fd, POLL)         # catch the headset being switched off/on
    except OSError:
        print("Device removed", flush=True)
    finally:
        os.close(fd)
